# Copia este archivo a .env.local y rellena los valores. Nunca subas claves reales.

# --- Cliente (se exponen al navegador) ---
# SDK web de Firebase (Project settings > General > Tu app web). Obligatorias salvo en modo demo.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Bucket de Storage (también lo usa el servidor para borrar fotos al eliminar la cuenta).
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 1 = demo sin Firebase, datos locales de ejemplo
NEXT_PUBLIC_DEMO_MODE=
# Token público de Pollinations para generar imágenes de platos (opcional).
NEXT_PUBLIC_POLLINATIONS_TOKEN=
# URL pública de la PWA Body Matter (enlace desde Perfil). Ej.: http://localhost:3001
NEXT_PUBLIC_BODYMATTER_ORIGIN=
# Origen público de esta app (para URLs absolutas fuera del navegador, p. ej. la app móvil). Opcional.
NEXT_PUBLIC_SITE_URL=

# --- Servidor (solo Node; nunca se exponen) ---
# Cuenta de servicio de Firebase Admin: JSON en una línea...
FIREBASE_SERVICE_ACCOUNT_JSON=
# ...o ruta a un archivo .json con la clave (alternativa a la anterior).
GOOGLE_APPLICATION_CREDENTIALS=
# Clave de la API de Groq (análisis de comida, coach, dietas).
GROQ_API_KEY=
# Modelo de Groq a usar (opcional; hay uno por defecto).
GROQ_MODEL=
# Timeout de las llamadas a Groq en milisegundos (opcional).
GROQ_TIMEOUT_MS=
# Clave privada de Pollinations para generar imágenes desde el servidor (opcional).
POLLINATIONS_API_KEY=
# Secreto del header Authorization del webhook de RevenueCat.
REVENUECAT_WEBHOOK_AUTH=
# Dominio de la cookie de sesión compartida con Body Matter, ej.: .tudominio.com (opcional).
SERVER_SESSION_COOKIE_DOMAIN=

# --- Cuotas diarias de IA por usuario (día UTC). Vacío = valor por defecto ---
# Análisis de comida: gratis (5) / premium (120)
FREE_DAILY_ANALYZE_LIMIT=
DAILY_ANALYZE_LIMIT=
# Consejos de nutrición: gratis (5) / premium (40)
FREE_DAILY_TIPS_LIMIT=
DAILY_TIPS_LIMIT=
# Coach (chat, insights, rutinas): gratis (15) / premium (200)
FREE_DAILY_COACH_LIMIT=
DAILY_COACH_LIMIT=
# Dietas (generar, procesar, tutoriales): gratis (5) / premium (40)
FREE_DAILY_DIETS_LIMIT=
DAILY_DIETS_LIMIT=
